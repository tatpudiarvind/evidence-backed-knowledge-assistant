# Local-only PostgreSQL credentials for Docker Compose. Change before sharing a host.
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=knowledge_assistant
POSTGRES_PASSWORD=local_dev_only

# Host ports
API_PORT=8000
WEB_PORT=5173
# Host port for PostgreSQL when it runs under Compose.
POSTGRES_PORT=5432

# The settings below are read from this root .env file when the API runs directly on the
# host, whichever folder it is started from. Compose builds its own DATABASE_URL using the
# service hostname and the PostgreSQL values above.
DATABASE_URL=postgresql+psycopg://knowledge_assistant:local_dev_only@127.0.0.1:5432/knowledge_assistant
CORS_ORIGINS=["http://localhost:5173"]
APP_ENV=development
# Seconds the API waits for a PostgreSQL connection before readiness reports 503.
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Accounts and sessions. Turn registration off once your own account exists.
REGISTRATION_ENABLED=true
SESSION_LIFETIME_HOURS=12
# Set to true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Uploads. Files are kept in backend/storage unless STORAGE_DIR is set; Compose keeps them
# in a named volume instead.
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_WORKSPACE=100
# STORAGE_DIR=/absolute/path/for/uploads

# Where the web app sends API requests. Vite reads this root file too; Compose sets the
# value for its own container.
VITE_API_BASE_URL=http://localhost:8000
