# Local-only PostgreSQL credentials for Docker Compose. Change before sharing a host.
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=knowledge_assistant
POSTGRES_PASSWORD=local_dev_only

# Host ports
API_PORT=8000
WEB_PORT=5173

# Used when running the API directly on the host. Compose builds its own DATABASE_URL
# using the service hostname and the PostgreSQL values above.
DATABASE_URL=postgresql+psycopg://knowledge_assistant:local_dev_only@localhost:5432/knowledge_assistant
CORS_ORIGINS=["http://localhost:5173"]
APP_ENV=development
# Seconds the API waits for a PostgreSQL connection before readiness reports 503.
DATABASE_CONNECT_TIMEOUT_SECONDS=3
