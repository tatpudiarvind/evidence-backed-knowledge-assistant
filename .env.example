# Local-only PostgreSQL credentials for Docker Compose. Change before sharing a host.
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=knowledge_assistant
POSTGRES_PASSWORD=local_dev_only

# Host ports. Compose publishes them on 127.0.0.1 only, out of other machines' reach.
API_PORT=8000
WEB_PORT=5173
# Host port for PostgreSQL when it runs under Compose.
POSTGRES_PORT=5432

# The settings below are read from this root .env file when the API runs directly on the
# host, whichever folder it is started from. Compose builds its own DATABASE_URL using the
# service hostname and the PostgreSQL values above.
DATABASE_URL=postgresql+psycopg://knowledge_assistant:local_dev_only@127.0.0.1:5432/knowledge_assistant
CORS_ORIGINS=["http://localhost:5173"]
APP_ENV=development
# Seconds the API waits for a PostgreSQL connection before readiness reports 503.
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Logs and metrics. The API logs to standard error as text, or as one JSON object per line
# with LOG_FORMAT=json. Lines logged while a request is handled carry its ID, the one the API
# returns in the X-Request-ID header. LOG_LEVEL=DEBUG adds the details of unexpected indexing
# errors, which can quote documents.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Serves request, answer, and indexing counts at /metrics, in Prometheus's format. Anyone who
# can reach the API can read them there.
METRICS_ENABLED=false

# Accounts and sessions. Turn registration off once your own account exists.
REGISTRATION_ENABLED=true
SESSION_LIFETIME_HOURS=12
# Set to true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Rate limits, counted in the API's memory and reset when it restarts. Sign-in and registration
# attempts are counted per network address (under Compose, connections from the host usually
# share one), questions per account.
RATE_LIMITS_ENABLED=true
SIGN_IN_ATTEMPTS_PER_MINUTE=10
REGISTRATION_ATTEMPTS_PER_HOUR=10
QUESTIONS_PER_MINUTE=10

# Uploads. Files are kept in backend/storage unless STORAGE_DIR is set; Compose keeps them
# in a named volume instead.
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_WORKSPACE=100
# Seconds an upload may take to arrive before the API gives up on it.
UPLOAD_TIMEOUT_SECONDS=120
# STORAGE_DIR=/absolute/path/for/uploads

# Indexing. A background thread in the API indexes uploaded documents one at a time. Changed
# chunk settings apply to documents indexed afterwards.
INGESTION_WORKER_ENABLED=true
CHUNK_SIZE_CHARACTERS=1000
CHUNK_OVERLAP_CHARACTERS=150
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_CHARACTERS=2000000
PARSE_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32
# Download the embedding model once with `python -m app.cli download-embedding-model` from the
# backend folder. It is kept in backend/models unless EMBEDDING_MODEL_DIR is set; Compose keeps
# it in a named volume instead.
# EMBEDDING_MODEL_DIR=/absolute/path/for/models

# Answers. With LLM_PROVIDER=ollama, a local Ollama server writes each answer from the
# passages found for the question. With none, or while Ollama doesn't reply, answers list the
# matching passages instead. Install the model once with
# `ollama pull qwen3:4b-instruct-2507-q4_K_M`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=120
# The model's context window in tokens. It must hold the passages, so the API refuses to start
# if ANSWER_CONTEXT_CHARACTERS is too large for it.
OLLAMA_CONTEXT_TOKENS=4096
ANSWER_CONTEXT_CHARACTERS=6000
# How many of the closest passages are considered, and how similar to the question (cosine,
# 0 to 1) a passage must be to count as evidence. Both were set by the evaluation's rules;
# see docs/evaluation/README.md.
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SIMILARITY=0.5
# Questions and their answers are deleted three days after they are asked. History hides
# them from then on; this background cleanup deletes them while the API runs.
QUESTION_CLEANUP_ENABLED=true
# Under Compose, Ollama on the host is usually out of the container's reach, because it
# listens on 127.0.0.1 only, so answers list passages unless both of these are set.
# COMPOSE_LLM_PROVIDER=ollama
# COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Where the web app sends API requests. Vite reads this root file too; Compose sets the
# value for its own container.
VITE_API_BASE_URL=http://localhost:8000
